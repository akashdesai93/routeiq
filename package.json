{
  "name": "routeiq",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "lint": "oxlint",
    "size": "node scripts/check-bundle-size.mjs",
    "build:signals": "node scripts/build-signal-tiles.mjs",
    "preview": "vite preview",
    "e2e:build": "node e2e/build.mjs",
    "e2e": "npm run e2e:build && playwright test",
    "e2e:report": "playwright show-report e2e-report/playwright"
  },
  "dependencies": {
    "@fontsource/barlow-condensed": "5.3.0",
    "@fontsource/inter": "5.3.0",
    "mapbox-gl": "3.34.2",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.65.0",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "oxlint": "1.92.0",
    "typescript": "7.0.2",
    "vite": "8.3.7",
    "vitest": "5.1.0"
  }
}
