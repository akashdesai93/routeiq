  "cards": [
    {
      "dot": "emerald",
      "title": "The portable part",
      "items": [
        "src/core is pure TypeScript: same inputs, same answer",
        "Everything else imports it through src/core/index.ts",
        "It is the part that gets ported to the Swift package RouteIQCore"
      ]
    },
    {
      "dot": "orange",
      "title": "Signal tile chain (providers/osm)",
      "items": [
        "1. Bundled tiles in public/seed/osm-signals (NC + SC)",
        "2. Device cache in IndexedDB via src/storage/kv.ts, refreshed after 30 days",
        "3. Overpass API, only for tiles the bundle does not fully cover",
        "Place book lives in localStorage (storage/local.ts, placeBook.ts)"
      ]
    },
    {
      "dot": "amber",
      "title": "In progress, not committed yet",
      "items": [
        "Live drive mode: real GPS + voice, foreground only",
        "New core files: tracking.ts, guidance.ts, speechQueue.ts, live.ts",
        "New device wrappers: speech.ts, wakeLock.ts, visibility.ts"
      ]
    },
    {
      "dot": "slate",
      "title": "Outside services",
      "items": [
        "Mapbox: Directions, Search Box, GL JS map (public token)",
        "Overpass: backup only. Geofabrik: build time only",
        "City of Charlotte list: optional gap-fill, likely to be dropped",
        "scripts/seed-charlotte.mjs saves the city snapshot into public/seed"
      ]
    }
