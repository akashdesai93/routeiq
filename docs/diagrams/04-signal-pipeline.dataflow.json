  "cards": [
    { "dot": "emerald", "title": "Build (by hand, about monthly)", "items": ["npm run build:signals reads Geofabrik extracts on disk, no network", "Keeps highway=traffic_signals, drops 288 non-intersection subtypes", "Writes 22,613 signals into 902 tile files (1.2 MB)", "index.json lists the 2,500 tiles fully inside NC + SC"] },
    { "dot": "violet", "title": "Load chain", "items": ["1. Bundle: a covered tile never touches cache or network", "2. Device cache: tiles outside the bundle, refreshed after 30 days", "3. Overpass: 2 requests at a time, 30 s pause doubling to 8 min", "City list only adds a point with no OSM signal within 60 m"] },
    { "dot": "cyan", "title": "Count rules (DEFAULT_SIGNAL_MATCH)", "items": ["Points within 60 m of each other are one intersection", "It must lie within 30 m of the route line", "The route must have an intersection within 40 m of it", "Counted signals within 40 m along the route count once", "Freeway stretches: signals over 30 m inside are left out"] },
    { "dot": "amber", "title": "Coverage, and limits", "items": ["Full: every tile loaded, the number is the answer", "Partial: a tile is missing, shown as a lower bound, not ranked", "None: shown as Signals: unknown, never as zero", "Counts are about 1-2 off on some routes", "Location of lights only: no public live signal-colour data"] }
  ]
