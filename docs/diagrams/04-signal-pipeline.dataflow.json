    { "id": "f8", "from": "loader", "to": "cluster", "label": "signal points", "variant": "emphasis" },
    { "id": "f9", "from": "cluster", "to": "near", "label": "intersections", "variant": "emphasis" },
    { "id": "f10", "from": "near", "to": "cross", "label": "near the line", "variant": "emphasis" },
    { "id": "f11", "from": "route", "to": "cross", "label": "its intersections" },
    { "id": "f12", "from": "cross", "to": "count", "label": "kept signals", "variant": "emphasis" }
